# Copy to `.env` and fill in. NEVER commit the real `.env` (it's git-ignored).

# ── Phone / Instagram (upload_post, main, telegram_bot) ──────────────────────
# WiFi-debugging IP:port (preferred) or USB serial. Update when it drifts.
PHONE_ADDRESS=192.168.1.130:36481
# Instagram accounts logged in on the phone, comma-separated, no leading @.
IG_ACCOUNTS=account_one,account_two
# Browser whose cookies gallery-dl may reuse for login-gated Instagram PHOTO
# posts (e.g. chrome / firefox / edge). Blank = anonymous; public posts still
# work, private/gated ones need a logged-in session.
GALLERY_DL_COOKIES_BROWSER=

# ── Telegram → Instagram trigger bot (modules/telegram/telegram_bot.py) ──────
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
TELEGRAM_CHAT_ID=-1001234567890

# ── YouTube Shorts (modules/youtube/) ────────────────────────────────────────
# Credentials are FILE-based, not in .env: put client_secrets.json (from Google
# Cloud Console) in credentials/youtube/<account>/ and run the uploader once
# interactively per account to generate token.pickle via the browser flow:
#   py modules/youtube/uploader.py video.mp4 --title "Test" --account <account>
# NOTE: uploads cost 1600 API quota units of a 10,000/day default budget per
# Google Cloud project (~6 uploads/day) — use one project per account.

# YouTube channels for the news-bot picker + dispatcher auto-upload, as
# account:lang pairs (account = folder name under credentials/youtube/).
YT_DESTINATIONS=myytaccount:en,myotheryt:ru

# Smart filter: auto-upload collected videos scoring at least this (0-100)
# to every YT_DESTINATIONS channel. 70 = the scorer's "high" tier floor.
YT_AUTO_MIN_SCORE=70

# ── Twitter/X poster (modules/twitter/poster.py) ─────────────────────────────
# Five vars per account: TWITTER_<ACCOUNT>_<FIELD>, where <ACCOUNT> is the
# account name uppercased (non-alphanumerics become "_"). Names match the 2026
# console (console.x.com): CONSUMER_KEY + SECRET_KEY come from the app's Keys
# page; the ACCESS pair is NOT shown there — mint it once per account with
#   py modules/twitter/authorize.py --account myxaccount --write
# AFTER setting the app's permissions to Read and Write (tokens inherit the
# permissions that existed when minted). The console's Client ID / Client
# Secret are OAuth 2.0 and not used by the bot. Old var names
# (CONSUMER_SECRET / ACCESS_TOKEN_SECRET) still work as fallbacks.
TWITTER_ACCOUNTS=myxaccount
TWITTER_MYXACCOUNT_CONSUMER_KEY=...
TWITTER_MYXACCOUNT_SECRET_KEY=...
TWITTER_MYXACCOUNT_BEARER_TOKEN=...
TWITTER_MYXACCOUNT_ACCESS_TOKEN=...      # from authorize.py
TWITTER_MYXACCOUNT_ACCESS_SECRET=...     # from authorize.py

# Twitter accounts in the news-bot picker, account:lang pairs (account must
# have its TWITTER_<ACCOUNT>_* vars above). Offered for single-photo/video
# posts; captions are translated per account language and trimmed to 280.
# NOTE pay-per-use billing: ~$0.015 per plain tweet, ~$0.20 if the tweet TEXT
# contains a link — the bot never adds links itself.
#TW_DESTINATIONS=myxaccount:en,myotherx:ru

# ── Telegram NEWS broadcaster (news_bot.py) ──────────────────────────────────
# Post news (text / photo / video / album) into the control group
# (TELEGRAM_CHAT_ID above) → the bot shows a channel picker → posts to the
# selected channels, translating the caption per channel.

# Destination news channels as chat_id:lang:region (add the bot as ADMIN to each).
# The region is what the AUTOPILOT routes on — the scorer tags each story with
# us / eu / ru / global, and a channel receives a story when its own region is
# among them ("global" reaches everyone). Use "+" for a multi-region channel.
# The region field is OPTIONAL: a chat_id:lang entry is a CATCH-ALL that gets
# every story over the score threshold, which is how it behaved before regions
# existed. Manual posting via the picker ignores regions entirely.
TG_DESTINATIONS=@my_news_us1:en:us,@my_news_us2:en:us,@my_news_eu:en:eu,@my_news_ru:ru:ru,@my_news_world:en:us+eu

# Language the source posts are written in — destinations with this lang are not
# translated. Leave blank to always translate.
SOURCE_LANG=en

# ── Telegram AUTOPILOT (autopilot.py, runs inside news_bot.py) ───────────────
# The drip: every random TG_DRIP_MIN_S..TG_DRIP_MAX_S it publishes the best
# unposted story to the channels whose region matches, then asks you in the
# control group which reactions to buy for each channel.
# Requires collector.py + dispatcher.py running — the dispatcher does the
# scoring, and unscored items are never posted.

# A collected story counts as news only if it carries MEDIA — photo(s),
# video(s) or both. Text-only source posts (commentary, link dumps,
# announcements) are rejected BEFORE scoring, so they cost nothing. Set to 0
# to allow them. Manual posting via the picker is never affected.
NEWS_REQUIRE_MEDIA=1

# Minimum score (0-100) to be ELIGIBLE for an autopilot post. Lower than
# YT_AUTO_MIN_SCORE: a Telegram post is free, a Shorts upload costs API quota.
TG_AUTO_MIN_SCORE=60

# Gap between posts, in seconds — a fresh random value in this range each time,
# so the channels never look metronomic. Default 18-24 hours (roughly one
# story a day, at an unpredictable hour).
TG_DRIP_MIN_S=64800
TG_DRIP_MAX_S=86400

# Stories older than this many hours are never auto-posted (stale news dripping
# out days late is worse than a quiet channel). Manual posting ignores it.
# MUST exceed TG_DRIP_MAX_S in hours, or everything collected since the last
# post expires before the next tick and the drip starves.
TG_MAX_AGE_H=48

# How many of the top-scoring eligible stories are compared head-to-head at
# post time to choose the one that actually goes out. Scoring judges each story
# alone as it arrives, so a day's queue clusters at 70-80; this is what picks
# the winner from within that cluster. Costs one model call per post.
# Set to 1 to disable and simply post the highest score.
TG_COMPARE_TOP=5

# Where the "which reactions?" question is sent. Blank = the control group
# (TELEGRAM_CHAT_ID). Set your personal chat id for a DM instead.
#TG_ASK_CHAT_ID=

# Start with the drip paused (0). Switch at runtime with /autopilot on|off.
TG_AUTOPILOT=1

# ── BulkFollows SMM panel (modules/telegram/smm.py) ──────────────────────────
# Orders placed against published Telegram posts. Every leg is optional: an
# unset key or service id is logged and skipped, never fatal to a post.
BULKFOLLOWS_API_KEY=your_panel_api_key
#BULKFOLLOWS_API_URL=https://bulkfollows.com/api/v2
# Ordered once per published post (quantity: random 500-5000).
BULKFOLLOWS_SERVICE_ID=1234
# Ordered against the CHANNEL itself every 5th post (quantity 10000).
BULKFOLLOWS_SERVICE_ID_BONUS=5678
# Reaction service ids are per emoji and live in modules/telegram/reactions.py
# (EMOJI_SERVICES) — edit them there if the panel renumbers its services.

# ── Telegram source collector (collector.py — future smart-filter input) ─────
# MTProto creds for the collector's user client — https://my.telegram.org.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# Big files in the news bot. The Bot API can't download past 20 MB or upload
# past 50 MB, which caps branding and the YouTube leg (Telegram channel posts
# are never capped — they re-send the file_id). With the creds above and a
# one-off `py modules/telegram/mtproto.py --login`, both go through your own
# account instead, up to Telegram's 2 GB. Set to 0 to stay on the Bot API.
TG_BIG_FILES=1

# Country code assumed when you type a phone in LOCAL form at the --login
# prompt (e.g. 078424624 -> +37378424624). Only affects that prompt; a number
# typed with a leading + is always used as-is. 373 = Moldova.
TG_PHONE_CC=373

# Source channels to collect from (comma-separated @usernames or numeric ids).
# You must already be a member of each private one.
TG_SOURCES=@some_source_channel,@another_source

# Translation + smart-filter scoring via OpenRouter (openrouter.ai).
# Model ids must exist on OpenRouter — check openrouter.ai/models.
# SCORER_MODEL is optional and falls back to TRANSLATE_MODEL.
OPENROUTER_API_KEY=sk-or-...
TRANSLATE_MODEL=openai/gpt-4o-mini
#SCORER_MODEL=openai/gpt-4o-mini

# ── Branded clips ("Brand it" flow in the news bot) ──────────────────────────
# One logo per brand at brands/<name>/logo.png; per-brand accounts are optional
# — an unset platform simply has no row in the publish picker.
#BRANDS=mirnews:en,rusnews:ru
#BRAND_MIRNEWS_TG=@mir_news
#BRAND_MIRNEWS_YT=mirnews
#BRAND_MIRNEWS_TW=mirnews
# Photo cards ("Create post"): the hero's subject is cut out (rembg) and laid
# over the two circle insets. Model downloads to ~/.rembg on first use:
# bria-rmbg (default, ~1 GB, best hair edges) or u2net (~170 MB, lighter).
#CARD_CUTOUT_MODEL=bria-rmbg

# ── Monitoring / alert email (shared/monitoring) ─────────────────────────────
# ALL monitoring is off until ALERT_SMTP_HOST + ALERT_EMAIL_TO are both set.
# Gmail/Workspace senders need an APP password (Security → App passwords).
#ALERT_SMTP_HOST=smtp.gmail.com
#ALERT_SMTP_PORT=587
#ALERT_SMTP_USER=you@example.com
#ALERT_SMTP_PASS=your_app_password
#ALERT_EMAIL_TO=you@example.com
# Error emails are per occurrence; this caps them per hour (0 = unlimited).
#ALERT_MAX_PER_HOUR=0
# Floors for the checks timer (py shared/monitoring/checks.py, every 5 min).
# 0 disables a leg — the newsroom checkout on the same VPS sets ALERT_CPU_PCT,
# ALERT_DISK_PCT, ALERT_MEM_PCT and ALERT_OPENROUTER_MIN to 0 so only master's
# timer checks machine + account. Verify the mailbox first:
#   py shared/monitoring/checks.py --test
#ALERT_CPU_PCT=80
#ALERT_DISK_PCT=85
#ALERT_MEM_PCT=90
#ALERT_BULKFOLLOWS_MIN=2
#ALERT_OPENROUTER_MIN=0.5
# healthchecks.io ping URLs — one check per process; blank = no heartbeat.
#HEALTHCHECK_URL_NEWSBOT=https://hc-ping.com/your-uuid-1
#HEALTHCHECK_URL_COLLECTOR=https://hc-ping.com/your-uuid-2
#HEALTHCHECK_URL_DISPATCHER=https://hc-ping.com/your-uuid-3
