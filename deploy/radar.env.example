# .env.radar — the OSINT radar's ONLY config (modules/radar/settings.py).
# Copy to .env.radar at the repo root. Never put a posting token of any
# platform here: the radar is alerts-only.

# --- The alert bot: its OWN token from @BotFather, not the news bot's -----
RADAR_BOT_TOKEN=
# The private Radar group — a SUPERgroup (-100…). Make it Public once, then
# Private again, before taking its id (the lite bot lesson).
RADAR_CHAT_ID=
# The NEWS BOT's control group id (the TELEGRAM_CHAT_ID of its .env). The
# 📤 Send to bot button has the listening account forward the video (or post
# the Reddit link) there, which opens the news bot's normal plan card —
# nothing is published without a tap there. Add the listening account to that
# group first.
RADAR_NEWS_BOT_CHAT_ID=

# --- The LISTENING Telegram account — a spare one, not the bots' account ---
# my.telegram.org -> API development tools. Then on the server:
#   ENV_FILE=.env.radar .venv/bin/python -m modules.radar --login   (QR scan; --phone for number + code)
#   ENV_FILE=.env.radar .venv/bin/python -m modules.radar --join
# The listening account must also be a member of the Radar group (it forwards
# the videos there).
RADAR_API_ID=
RADAR_API_HASH=

# --- AI labels (OpenRouter; same key as the bots is fine) -----------------
OPENROUTER_API_KEY=
# RADAR_LABEL_MODEL=google/gemini-2.5-flash
# RADAR_AI_MAX_PER_DAY=400        # 0 = rules only

# --- Alerting ----------------------------------------------------------------
# A video alerts only when the AI calls it a real event rated this high
# (talking heads, routine war clips and claims score low by design):
# RADAR_AI_MIN=75
# RADAR_AI_MIN_US=60
# RADAR_ALERT_MIN_SCORE=60        # rank floor on top of the AI gate
# RADAR_CLUSTER_WINDOW_H=12       # one alert per story, edited as it grows
# RADAR_QUAKE_FLOOR_US=4.0        # no US quake alert below this magnitude
# RADAR_MAX_PER_HOUR=0            # runaway guard only; 0 = no cap
# RADAR_BLOCK_CATEGORIES=         # e.g. war,politics
# RADAR_US_BONUS=10

# --- Reddit ------------------------------------------------------------------
# Reddit closed its API to new apps (Oct 2026). Posts are FOUND through Arctic
# Shift (free archive, no key); their LIVE upvotes are read with a SPARE Reddit
# account's session — never the news bot's credentials/reddit_cookies.txt.
# Log the spare account in, export cookies.txt (Netscape format, e.g. the
# "Get cookies.txt LOCALLY" extension) to this path. No file = Reddit off.
# RADAR_REDDIT_COOKIES_FILE=modules/radar/data/reddit_cookies.txt
# More spare accounts = more files beside it: reddit_cookies_2.txt, _3, …
# (requests take turns; one Reddit refuses is dropped and named in the group).
# RADAR_REDDIT_CHECKS_MAX=3       # live upvote reads per post
# RADAR_REDDIT_RECHECK_M=30       # minutes between them
# RADAR_REDDIT_POLL_S=600
# RADAR_REDDIT_MAX_AGE_H=4
# RADAR_REDDIT_SUBS=PublicFreakout,CrazyFuckingVideos,...
# RADAR_REDDIT_MIN_UPS=50

# --- Briefing ------------------------------------------------------------------
# RADAR_TZ=Europe/Chisinau
# RADAR_BRIEFING_AT=21:00         # "" = off
