# .env.radar — the OSINT radar's ONLY config (modules/radar/settings.py).
# Copy to .env.radar at the repo root. Never put a posting token of any
# platform here: the radar is alerts-only.

# --- The alert bot: its OWN token from @BotFather, not the news bot's -----
RADAR_BOT_TOKEN=
# The private Radar group — a SUPERgroup (-100…). Make it Public once, then
# Private again, before taking its id (the lite bot lesson).
RADAR_CHAT_ID=

# --- The LISTENING Telegram account — a spare one, not the bots' account ---
# my.telegram.org -> API development tools. Then on the server:
#   ENV_FILE=.env.radar .venv/bin/python -m modules.radar --login   (--qr to scan)
#   ENV_FILE=.env.radar .venv/bin/python -m modules.radar --join
# The listening account must also be a member of the Radar group (it forwards
# the videos there).
RADAR_API_ID=
RADAR_API_HASH=

# --- AI labels (OpenRouter; same key as the bots is fine) -----------------
OPENROUTER_API_KEY=
# RADAR_LABEL_MODEL=google/gemini-2.5-flash
# RADAR_AI_MAX_PER_DAY=400        # 0 = rules only

# --- Alerting ----------------------------------------------------------------
# RADAR_ALERT_MIN_SCORE=60
# RADAR_MAX_PER_HOUR=0            # runaway guard only; 0 = no cap
# RADAR_BLOCK_CATEGORIES=         # e.g. war,politics
# RADAR_US_BONUS=10

# --- Reddit: a free "script" app at reddit.com/prefs/apps ---------------------
# Without these Reddit answers 403 (it blocks the keyless JSON).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# RADAR_REDDIT_SUBS=PublicFreakout,CrazyFuckingVideos,...
# RADAR_REDDIT_MIN_UPS=50

# --- Briefing ------------------------------------------------------------------
# RADAR_TZ=Europe/Chisinau
# RADAR_BRIEFING_AT=21:00         # "" = off
