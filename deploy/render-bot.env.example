# Template for /opt/ig-automatization2/.env.lite — the LITE render bot.
#
# Same checkout and code as news-bot, started with ENV_FILE=.env.lite and
# BOT_MODE=lite: a video in its group -> plan card (headline reply, edit:,
# ▶ Preview edit) -> 🎬 Render -> spell-fixed headline, branded clip sent back
# into the group. Nothing is published; no posting credentials are loaded
# (credentials/brands/ is skipped in lite mode, and the bot refuses to start
# if any destination or BRAND_<NAME>_TG/YT/TW/IG/FB is set here).
#
# ONLY this file is loaded — nothing from the main .env reaches it.

BOT_MODE=lite

# Its OWN bot from @BotFather. Never the main bot's token: one token = one
# poller, and the two bots would steal each other's updates.
NEWS_BOT_TOKEN=

# The lite group's id (negative). The bot answers in this chat only.
TELEGRAM_CHAT_ID=

# Its own DB, busy marker, media dir and Telethon session. Must differ from
# the main bot's modules/telegram/data.
TG_DATA_DIR=modules/telegram/data_lite

# The one brand: brands/<group>/<name>/logo.png (+ optional style.json).
# No ":lang" = the headline is rendered as typed (no translation call).
BRANDS=PulseNews

# Big files: your account, through its own session file in TG_DATA_DIR.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Headline spelling fix (modules/telegram/spellfix.py)
OPENROUTER_API_KEY=

IG_VISION_ENABLED=0
IG_CAPTION_ENABLED=0
BRAND_RENDER_BATCH=1

# Same inbox as the main bot; subjects start with [lite-render-bot].
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_EMAIL_TO=
HEALTHCHECK_URL_NEWSBOT=
