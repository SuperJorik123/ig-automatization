# Secrets
.env
.env.*
!.env.example

# Per-brand account files + YouTube OAuth folders (client_secrets.json,
# token.pickle, brands/<name>.json). Only the template is tracked — a negation
# cannot re-include anything under an excluded DIRECTORY, so each level
# excludes its CONTENTS and re-admits the directory below it.
credentials/*
!credentials/brands/
credentials/brands/*
!credentials/brands/_example.json

# Telegram news aggregator runtime state — the .session file is a LOGIN
# CREDENTIAL; media + the SQLite queue are local runtime artefacts.
modules/telegram/data/

# Monitoring state (shared/monitoring/checks.py) — repo-root data/ only.
/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# yt-dlp / runtime artefacts
*.part
ui_dump*.xml

# Node / Angular (ui/ has its own .gitignore but cover the root too)
node_modules/
dist/
.angular/

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Client newsroom bot runtime state (SQLite store)
modules/newsroom/data/
